# =============================================================================
# e2e 테스트 전용 환경변수 (test/jest-e2e.json이 test/setup-env.ts를 통해 로드함)
# =============================================================================
# 개발용 .env와 완전히 분리된 별도 DB(credobounty_test)를 쓴다 - 테스트를 돌릴
# 때마다 개발 중 수동으로 만들어둔 계정/바운티 데이터가 섞이거나 지워지는 사고를
# 막기 위함. 아래 값들은 전부 테스트 전용이라 실제 운영 비밀값이 아니며,
# 그래서 (.env와 달리) 이 파일은 git에 커밋되어 있다 - 다른 환경에서 이 저장소를
# clone해도 별도 설정 없이 바로 `npm run test:e2e`가 돌아가게 하기 위함.
#
# 최초 1회, 테스트 DB 자체는 미리 만들어둬야 한다 (schema는 synchronize:true라
# 앱이 뜨면서 자동 생성됨 - DB 자체만 있으면 됨):
#   createdb credobounty_test   (또는) psql -c "CREATE DATABASE credobounty_test;"
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=credobounty_test

# openssl rand -hex 32로 생성한 테스트 전용 값 (운영 JWT_SECRET과 무관, 유출돼도 무방)
JWT_SECRET=test_only_9f2b6e1a4c8d7f3b5e0a2c6d8f1b3e5a7c9d0f2b4e6a8c0d2f4b6e8a0c2d4f6b

FRONTEND_ORIGIN=http://localhost:3000
PAYMENT_GATEWAY_DRIVER=mock
PORTONE_WEBHOOK_SECRET=whsec_test_only_dGVzdHNlY3JldGZvcmNyZWRvYm91bnR5
