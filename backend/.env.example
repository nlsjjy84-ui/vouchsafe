# 이 파일을 복사해서 .env로 만들고 실제 값으로 채운다. .env는 git에 커밋하지 않는다.
#
# 로컬 개발: 아래 DB_* 개별 변수 조합을 그대로 쓴다.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=credobounty

# 배포(Render/Railway 등 매니지드 Postgres): 아래 DATABASE_URL 하나만 채우면
# 위 DB_* 변수 대신 이 값이 우선 사용되고, TLS(ssl)도 자동으로 켜진다.
# 예: postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# 매니지드 Postgres인데 DB_* 개별 변수 조합을 그대로 쓰고 싶다면 이것만 true로 켠다.
# DB_SSL=false

JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173

PORT=8080
