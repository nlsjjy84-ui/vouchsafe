# 이 파일을 복사해서 .env로 만들고 실제 값으로 채운다. .env는 git에 커밋하지 않는다.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=credobounty

# [보안 강화] 반드시 실제 값으로 교체해야 한다 - 이 예시 값 그대로 두면 서버가
# 아예 부팅되지 않는다(common/config/jwt-secret.util.ts). 터미널에서
# `openssl rand -hex 32` 실행 후 나온 값을 그대로 붙여넣으면 된다.
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000

PORT=8080

# 파일 저장소: 기본은 mock(로컬 uploads 폴더). 실제 AWS 계정이 준비되면 s3로 바꾸고
# 아래 AWS_* 값을 채운다 (자세한 절차는 src/mocks/s3-storage.service.ts 상단 주석 참고).
STORAGE_DRIVER=mock
# STORAGE_DRIVER=s3
# AWS_REGION=ap-northeast-2
# AWS_S3_BUCKET=credobounty-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 결과물 제출 후 의뢰인이 승인도 이의제기도 안 하면 이 기간(일)이 지났을 때
# 자동으로 정산 처리한다 (먹튀 방지 장치). 기본값 5일.
AUTO_SETTLE_DAYS=5

# 포트원(PortOne) V2 API - 결제 검증/취소 실연동 (샌드박스/테스트 모드 키로 시작 가능,
# 사업자등록 불필요). 발급처: admin.portone.io > 결제 연동 > 연동 정보 > 식별코드 · API Keys
PORTONE_STORE_ID=
PORTONE_API_SECRET=

# mock: 결제 즉시 성공 처리(기본값). portone: 실제 포트원 API로 결제 검증/취소.
PAYMENT_GATEWAY_DRIVER=mock

# 포트원 웹훅 서명 검증용 시크릿. 발급처: admin.portone.io > 결제 연동 > 연동 관리
# > 결제알림(Webhook) 관리 탭 > [웹훅 시크릿 발급]. 이 값이 없으면 웹훅 엔드포인트가
# 모든 요청을 401로 거부한다 (검증할 수 없는 요청은 무조건 거부 - 안전한 기본값).
PORTONE_WEBHOOK_SECRET=
