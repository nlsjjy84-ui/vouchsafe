# 이 파일을 복사해서 .env로 만들고 실제 값으로 채운다. .env는 git에 커밋하지 않는다.
#
# 로컬 개발: 아래 DB_* 개별 변수 조합을 그대로 쓴다.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=credobounty

# 배포(Render/Railway 등 매니지드 Postgres): 아래 DATABASE_URL 하나만 채우면
# 위 DB_* 변수 대신 이 값이 우선 사용되고, TLS(ssl)도 자동으로 켜진다.
# 예: postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# 매니지드 Postgres인데 DB_* 개별 변수 조합을 그대로 쓰고 싶다면 이것만 true로 켠다.
# DB_SSL=false

JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173

PORT=8080

# 결제(PG) 연동 드라이버. 기본값(mock)이면 항상 결제 성공으로 처리한다 - 사업자
# 등록/PG 계약 없이도 결제 확인 게이트 흐름 전체를 개발·시연할 수 있다.
# 실제 포트원 연동을 시험하려면 portone으로 바꾸고 아래 두 값을 채운다
# (발급처: admin.portone.io > 결제 연동 > 연동 정보 > 식별코드 · API Keys > V2 API,
#  사업자등록 없이도 테스트 키 발급은 바로 가능하다).
# PAYMENT_GATEWAY_DRIVER=portone
# PORTONE_API_SECRET=
# (참고용) 프론트엔드(.env.local)가 결제창을 띄울 때 쓰는 "공개용" 식별자 -
# 이 파일(백엔드)에는 필요 없지만, 같은 포트원 프로젝트 값이어야 한다.
# NEXT_PUBLIC_PORTONE_STORE_ID=
# NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
