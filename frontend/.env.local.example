# 이 파일을 복사해서 .env.local로 만들고 실제 값으로 채운다. .env.local은 git에 커밋하지 않는다.
NEXT_PUBLIC_API_BASE=http://localhost:8080

# 포트원(PortOne) 결제창 연동에 필요한 "공개용" 식별자들 (API Secret과 달리 노출돼도 안전).
# 발급처: admin.portone.io
#  - STORE_ID: 결제 연동 > 연동 정보 > 식별코드 · API Keys
#  - CHANNEL_KEY: 결제 연동 > 연동 정보 > 채널 관리 > (등록한 채널 클릭) > 채널 키
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
